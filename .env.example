TRANSCRIPTION_API_URL=http://127.0.0.1:18010
PODCAST_API_URL=http://127.0.0.1:18000
# Historical podcast data lives in this project's data/ after migration.
HOST=127.0.0.1
PORT=18000
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8001
# Analysis backend: pi (kimi/k3), codex (gpt-6.1-sol/high), or agy (Gemini).
PODCAST_ANALYSIS_BACKEND=pi
# Any failed pi invocation switches to Codex; persist a one-hour cooldown. Set none to disable.
PODCAST_ANALYSIS_FALLBACK=codex
# No total deadline. Stop only after this many seconds without visible progress; 0 disables.
PODCAST_ANALYSIS_IDLE_TIMEOUT_SECONDS=1200
# Pi RPC: queue a wrap-up reminder every 15 minutes; 0 disables.
PODCAST_ANALYSIS_REMINDER_SECONDS=900
# Attempts per backend for transient failures. With fallback enabled, pi switches after its first failed invocation.
PODCAST_ANALYSIS_ATTEMPTS=2
PODCAST_AGY_MODEL=gemini-3.1-pro-high
# Second pass: rewrite article.md with lieflat-less-ai-tone via agy; off publishes the first draft.
PODCAST_DEAI=on
PODCAST_DEAI_MODEL=gemini-4-argon-medium
WHISPER_SUBSCRIPTION_IDLE_SECONDS=5

# Only the optional Whisper text-cleaning branch uses these settings.
WHISPER_LLM_BASE_URL=https://example.com/v1
WHISPER_LLM_API_KEY=
WHISPER_LLM_MODEL=qwen3.8-27b

# Optional MiMo backend: export MIMO_API_KEY in your shell environment.
# Do not put an empty MIMO_API_KEY in an env file; it can hide an existing value.
